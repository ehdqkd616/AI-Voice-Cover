# ── Database ─────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=app_pass
POSTGRES_DB=ai_voice_cover
DATABASE_URL=postgresql+psycopg://app:app_pass@postgres:5432/ai_voice_cover

# ── Redis (queue + cache + progress pub/sub) ────────────────
REDIS_URL=redis://redis:6379/0

# ── Object storage (MinIO locally, S3 in prod) ──────────────
S3_ENDPOINT=http://minio:9000
# Endpoint the browser can reach for presigned URLs — must be the whole domain with
# no path prefix (presigned SigV4 signs the Host header, so a stripped-prefix reverse
# proxy would break signature verification).
S3_PUBLIC_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-voice-cover-media
S3_REGION=us-east-1

# ── Admin bootstrap ────────────────────────────────────────
# Set both and restart the api container once to create the first approved
# admin account (only happens if no user with this email exists yet).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3010

# ── Limits ───────────────────────────────────────────────
# This is a personal, non-public instance — quotas are relaxed compared to a
# public deploy. Tighten these before ever exposing this to other users.
MAX_UPLOAD_MB=200
MAX_UPLOAD_DURATION_SEC=900
MAX_YOUTUBE_DURATION_SEC=900
ANON_DAILY_DOWNLOAD_LIMIT=100
ANON_DAILY_SEPARATE_LIMIT=50

# Kept for a year by default on a personal instance; the beat task that purges
# expired media still runs periodically, it just won't touch anything for a
# long time. Lower this before ever exposing the app publicly.
MEDIA_TTL_HOURS=8760

# ── yt-dlp ───────────────────────────────────────────────
# Optional residential proxy, e.g. http://user:pass@host:port. Leave empty locally.
PROXY_URL=
COOKIE_PATH=

# ── Demucs (separation stage) ────────────────────────────
DEMUCS_DEVICE=cuda
DEMUCS_FAST_MODEL=htdemucs
DEMUCS_HQ_MODEL=htdemucs_ft

# ── RVC (voice conversion stage) ─────────────────────────
# weights/indices are resolved by filename under these directories, which
# live on the `voice-models` named volume (see docker-compose.yml) — not S3.
RVC_WEIGHT_ROOT=/srv/models/weights
RVC_INDEX_ROOT=/srv/models/indices
RVC_DEFAULT_F0_METHOD=rmvpe
RVC_DEFAULT_INDEX_RATE=0.75
RVC_DEFAULT_PROTECT=0.33
RVC_DEFAULT_RMS_MIX_RATE=0.25
# The vendored RVC engine auto-enables CUDA graph capture on any CUDA device
# (tools/cuda_graph.py) — helps repeated same-shape calls (realtime/streaming
# use), but each captured graph pins its own CUDA memory pool (~1.9GB seen in
# testing) that a one-shot per-job conversion never benefits from. On a small
# GPU shared with Demucs in the same worker process, that alone can OOM.
# Leave at 0 unless you have VRAM to spare and want the speedup.
RVC_CUDA_GRAPH=0
# Leave unset to auto-detect CUDA. Set to an empty string to force CPU-only
# (e.g. while the host GPU driver mismatch below is unresolved) — both Demucs
# and RVC respect this the same way.
# CUDA_VISIBLE_DEVICES=

# ── Mix stage ─────────────────────────────────────────────
MIX_DEFAULT_OUTPUT_FORMAT=mp3-320
MIX_DEFAULT_VOCAL_GAIN_DB=0

# ── Local infra ports (kept separate from Music-Tools' stack) ───────────
POSTGRES_PORT=5433
REDIS_PORT=6380
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
API_PORT=8010
WEB_PORT=3010

# ── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8010

# NOTE: as of this build, `nvidia-smi` on this host fails with "Driver/library
# version mismatch" — a host driver issue outside this project's scope. Both
# GPU-bound stages (Demucs + RVC) fall back to CPU automatically if CUDA isn't
# available, just much slower; fix the host driver (likely a reboot) to get
# GPU acceleration back.
